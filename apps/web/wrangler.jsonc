{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pab-web",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "pab.dev", "custom_domain": true },
    { "pattern": "www.pab.dev", "custom_domain": true }
  ],
  "assets": { "directory": "./public" },
  "dev": { "port": 8787, "inspector_port": 9230 }
}
